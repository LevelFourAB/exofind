---
/*
 * The front page.
 *
 * It is a page rather than a document in `docs/`, because what it says is
 * addressed to someone who has not decided to read the documentation yet -
 * and because the links it makes have to carry the path the site is served
 * under, which a file read on GitHub cannot know.
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Code, TabItem, Tabs } from '@astrojs/starlight/components';

import DemoList from '../components/DemoList.astro';
import { demo } from '../examples/demos.mjs';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const runCommand = `docker run -d --name exofind -p 8080:8080 \\
  -v exofind-data:/data \\
  -e EXOFIND_AUTH_ROOT_KEY=exok_quickstart \\
  ghcr.io/levelfourab/exofind:main-latest`;

const defineIndex = `PUT /v1alpha1/admin/indexes/books
Authorization: Bearer exok_quickstart
Content-Type: application/json

{
  "fields": {
    "id": { "type": "string", "primaryKey": true, "required": true },
    "title": { "type": "string", "matching": { "typoTolerance": {} }, "sort": {} },
    "category": { "type": "string", "filter": {}, "facet": {} },
    "published": { "type": "boolean", "filter": {} }
  }
}`;

const searchIndex = `POST /v1alpha1/indexes/books/search
Authorization: Bearer exok_quickstart
Content-Type: application/json

{
  "query": [
    { "type": "text", "text": "silent spr" },
    { "field": "published", "match": { "value": true } }
  ],
  "limit": 20
}`;

/*
 * The demo the hero leads with. Someone who has read one sentence about the
 * engine wants to see it search, not choose which search to see, so the
 * button opens a demo rather than the catalogue - the widest dataset, and the
 * one that shows the most in a single screen. Naming it here rather than
 * writing the path is what makes a demo that is renamed or dropped a build
 * failure instead of a link to nothing.
 */
const featured = demo('cleveland');

/*
 * What the engine does, and the page that shows each claim is true. The
 * heading is the link rather than the whole block, because the blocks are a
 * pitch and the ones under "Where to go" are the navigation - a reader who
 * finds one claim interesting follows it, and a reader who does not reads on.
 */
const features = [
	{
		title: 'Object storage is the source of truth',
		body: 'Wipe a node and it pulls the index back from the bucket. Nodes '
			+ 'coordinate with conditional writes, without Raft or cluster '
			+ 'coordinators.',
		href: `${base}/explanation/architecture/`
	},
	{
		title: 'Search powered by Lucene',
		body: 'Full-text matching with typo tolerance, prefix autocomplete, '
			+ 'geospatial filters, nested sub-documents, and k-nearest neighbors (KNN) '
			+ 'vector search.',
		href: `${base}/how-to/search-an-index/`
	},
	{
		title: 'Per-value language analysis',
		body: 'Documents carry their language tag. The engine applies CJK '
			+ 'segmentation, stemming, and Scandinavian compound splitting automatically '
			+ 'without custom pipeline setup.',
		href: `${base}/reference/locales/`
	},
	{
		title: 'Declarative schemas and index generations',
		body: 'Send the schema you want with a PUT request. When a change requires a '
			+ 'reindex, Exofind builds a new generation in the background and '
			+ 'promotes it while queries continue.',
		href: `${base}/how-to/roll-out-a-definition-change/`
	},
	{
		title: 'Shared keys without a database',
		body: 'API keys are stored in the bucket. A key created on one node propagates '
			+ 'to all nodes within seconds, scoped by permissions and index '
			+ 'patterns.',
		href: `${base}/how-to/secure-a-deployment/`
	},
	{
		title: 'Interchangeable stateless nodes',
		body: 'Read nodes never talk to each other. Nodes answer every query from '
			+ 'local disk and scale horizontally behind standard load balancers.',
		href: `${base}/explanation/deployment-shapes/`
	}
];

/*
 * The four kinds of documentation, each entered at the page a reader who has
 * only read the front page should start it at. They are the sections of
 * `docs/README.md` and they say what each kind is for, which is what tells a
 * reader with a question which of the four to open.
 */
const doors = [
	{
		title: 'Tutorials',
		body: 'Run a node and define an index.',
		href: `${base}/tutorials/getting-started/`
	},
	{
		title: 'How-to guides',
		body: 'Solve one task at a time.',
		href: `${base}/how-to/define-an-index/`
	},
	{
		title: 'Reference',
		body: 'API references, field types and other details.',
		href: `${base}/reference/configuration/`
	},
	{
		title: 'Explanation',
		body: 'Covers why the design is the way it is.',
		href: `${base}/explanation/architecture/`
	}
];
---

<StarlightPage
	frontmatter={{
		title: 'Exofind',
		description: 'Delightful search built on object storage',
		template: 'splash',
		tableOfContents: false,
		/*
		 * The site is called what this page is called, and the layout would
		 * otherwise join the two into "Exofind | Exofind".
		 */
		head: [{ tag: 'title', content: 'Exofind' }],
		/*
		 * One line says what the engine is, and the sentence under it says how
		 * it works. The name of the site is the label over the headline rather
		 * than the headline itself - see `../components/Hero.astro` - which is
		 * what leaves the headline free to be the pitch.
		 */
		hero: {
			title: 'Delightful search built on object storage',
			tagline: 'Full-text search, automatic language analysis, and schema updates without downtime. Nodes answer queries from local disk and coordinate through an S3 bucket alone.',
			actions: [
				{ text: 'Get started', link: `${base}/tutorials/getting-started/`, icon: 'right-arrow', variant: 'primary' },
				{ text: 'See it searching', link: `${base}/examples/${featured.name}/`, icon: 'magnifier', variant: 'secondary' },
				{ text: 'GitHub', link: 'https://github.com/LevelFourAB/exofind', icon: 'external', variant: 'minimal' }
			]
		}
	}}
>
	<div class="quickstart">
		<Tabs>
			<TabItem label="1. Run node">
				<Code code={runCommand} lang="shell" />
			</TabItem>
			<TabItem label="2. Define index">
				<Code code={defineIndex} lang="http" />
			</TabItem>
			<TabItem label="3. Search">
				<Code code={searchIndex} lang="http" />
			</TabItem>
		</Tabs>
	</div>

	<h2>What it does</h2>

	<div class="features not-content">
		{features.map(feature => (
			<div class="feature">
				<h3><a href={feature.href}>{feature.title}</a></h3>
				<p>{feature.body}</p>
			</div>
		))}
	</div>

	<h2>See it searching</h2>

	<p>
		Each demo searches a real dataset through a node, and exists to show one
		thing the engine can do.
	</p>

	<DemoList />

	<h2>Where to go</h2>

	<div class="doors not-content">
		{doors.map(door => (
			<a class="door" href={door.href}>
				<h3>{door.title}</h3>
				<p>{door.body}</p>
			</a>
		))}
	</div>
</StarlightPage>

<style>
	.quickstart {
		margin-block-start: 1.5rem;
	}

	/*
	 * The grids opt out of the prose styling - `not-content` - because that
	 * styling puts a top margin on every block that follows another one, and
	 * here the blocks are cells rather than paragraphs: the margin lands on
	 * every cell but the first and drops the rest of the row below it. The
	 * spacing is the grid's gap instead, so the headings of a row start on one
	 * line.
	 */
	.features {
		align-items: start;
		display: grid;
		gap: 1.875rem 2.5rem;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
	}

	/*
	 * Each block is counted and ruled rather than boxed, which is the same
	 * mark the numbered sections of the manual carry - six things the engine
	 * does, read as six rather than as a wall.
	 */
	.feature,
	.door {
		align-content: start;
		border-block-start: 1px solid var(--sl-color-gray-5);
		display: grid;
		gap: 0.375rem;
		padding-block-start: 0.8125rem;
		text-decoration: none;
	}

	.features {
		counter-reset: feature;
	}

	.feature::before {
		color: var(--sl-color-gray-3);
		content: counter(feature, decimal-leading-zero);
		counter-increment: feature;
		font-family: var(--sl-font-mono);
		font-size: 0.6875rem;
		font-variant-numeric: tabular-nums;
		font-weight: 500;
		letter-spacing: 0.1em;
	}

	/* Opting out of the prose styling means the heading carries its own. */
	.feature h3,
	.door h3 {
		color: var(--sl-color-white);
		font-size: 1.0625rem;
		font-weight: 600;
		letter-spacing: -0.005em;
		line-height: 1.3;
		margin-block: 0;
	}

	/*
	 * The underline is there before the pointer is, because a link that only
	 * appears on hover is a link a touch device never shows.
	 */
	.feature h3 a {
		color: inherit;
		text-decoration: underline;
		text-decoration-color: var(--sl-color-gray-5);
		text-underline-offset: 0.2em;
	}

	.feature h3 a:hover {
		color: var(--sl-color-text-accent);
		text-decoration-color: currentColor;
	}

	.feature p,
	.door p {
		color: var(--sl-color-gray-2);
		font-size: 0.90625rem;
		line-height: 1.6;
		margin-block: 0;
	}

	/* Four ways in, side by side, and one line each about what is behind them. */
	.doors {
		display: grid;
		gap: 1.875rem 2.5rem;
		grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
	}

	.door h3 {
		font-size: 1rem;
	}

	.door:hover h3 {
		color: var(--sl-color-text-accent);
	}
</style>
