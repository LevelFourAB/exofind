---
/*
 * The way in to the REST API: what a call needs before any endpoint is read,
 * and then every endpoint there is.
 *
 * The three things a first call needs are the address, the key, and the media
 * type, and all three are in the document rather than written here. The list
 * under them is every endpoint on one page, because a reader who knows what they
 * want to do finds it faster by reading thirty-one lines than by opening eight
 * groups in the sidebar.
 *
 * The types close the page. They are the parts a request is built from that no
 * one endpoint states in full - see `../../openapi/types.mjs` - and a reader who
 * has a type name and no endpoint to hang it on starts here.
 *
 * A tag links to the page of the manual that explains the endpoints under it,
 * where the document names one. That is the division these pages are built
 * around: an endpoint page states one call in full, and the manual explains the
 * parts of the API that are not one call.
 */
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

import Prose from "../../components/api/Prose.astro";
import { localHref } from "../../openapi/markdown.mjs";
import { pathOf, typePathOf } from "../../openapi/sidebar.mjs";
import {
	authentication,
	document,
	sections,
	serverUrl,
	types,
} from "../../openapi/spec.mjs";
import { REPO } from "../../site.mjs";
import { slug } from "github-slugger";

const auth = authentication();
const listed = sections();
const listedTypes = types();

/** The heading the types are listed under, which is also its own anchor. */
const TYPES = "Types";

/*
 * The on-this-page list, stated rather than collected. Starlight reads the
 * headings of a Markdown page as it renders it, and this page is a component:
 * the headings below are the ones a reader sees, so they are the ones named
 * here, and each `slug` is the `id` of the heading it stands for.
 */
const headings = [
	...listed.map((section) => ({
		depth: 2,
		slug: slug(section.name),
		text: section.name,
	})),
	{ depth: 2, slug: slug(TYPES), text: TYPES },
];
---

<StarlightPage
	headings={headings}
	frontmatter={{
		title: "REST API",
		description:
			"API endpoints for Exofind, how to call them and what to expect when you do.",
	}}
>
	<p>
		API endpoints, see{" "}
		<a href="/reference/api-conventions/">API reference</a> for general
		API-guidance. Full OpenAPI spec is available at{" "}
		<a href="/openapi.yaml">/openapi.yaml</a>.
	</p>

	{listed.map((section) => (
		<>
			<h2 id={slug(section.name)}>{section.name}</h2>
			<section class="section not-content">
				<Prose
					text={section.description}
					variant="inline"
					class="says"
				/>

				<ul class="endpoints">
					{section.operations.map((operation) => (
						<li>
							<a href={pathOf(operation)}>
								<span
									class:list={[
										"method",
										`method-${operation.method.toLowerCase()}`,
									]}
								>
									{operation.method}
								</span>
								<span class="summary">{operation.summary}</span>
								<code class="path">{operation.path}</code>
							</a>
						</li>
					))}
				</ul>
			</section>
		</>
	))}

	<h2 id={slug(TYPES)}>{TYPES}</h2>
	<section class="section not-content">
		<ul class="types">
			{listedTypes.map((type) => (
				<li>
					<a href={typePathOf(type.name)}>{type.name}</a>
				</li>
			))}
		</ul>
	</section>
</StarlightPage>

<style>
	/* What a first call needs, as two rows rather than as a prose paragraph. */
	.start {
		border-block-start: 1px solid var(--sl-color-gray-5);
		margin-block-start: 1.5rem;
	}

	.fact {
		border-block-end: 1px solid var(--sl-color-gray-5);
		display: grid;
		gap: 0.25rem 1.25rem;
		grid-template-columns: 4.5rem minmax(0, 1fr);
		padding-block: 0.75rem;
	}

	.label {
		color: var(--sl-color-gray-3);
		font-family: var(--sl-font-mono);
		font-size: 0.625rem;
		font-weight: 500;
		letter-spacing: 0.16em;
		line-height: 1.9;
		text-transform: uppercase;
	}

	.fact code {
		color: var(--sl-color-white);
		font-family: var(--sl-font-mono);
		font-size: 0.8125rem;
		overflow-wrap: anywhere;
	}

	.fact .says {
		font-size: 0.875rem;
		grid-column: 2;
		line-height: 1.6;
	}

	.section + .section {
		margin-block-start: 2rem;
	}

	.section-head {
		align-items: baseline;
		display: flex;
		gap: 1rem;
		justify-content: space-between;
	}

	.section h3 {
		color: var(--sl-color-white);
		font-size: 1.0625rem;
		font-weight: 600;
		letter-spacing: -0.005em;
		margin: 0;
	}

	.reference {
		color: var(--sl-color-gray-3);
		font-family: var(--sl-font-mono);
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: 0.16em;
		text-decoration: none;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.reference:hover {
		color: var(--sl-color-text-accent);
	}

	.section .says {
		font-size: 0.90625rem;
		line-height: 1.6;
		margin-block-start: 0.25rem;
	}

	.endpoints {
		list-style: none;
		margin: 0.75rem 0 0;
		padding: 0;
	}

	/*
	 * A row per endpoint: the method, what it does, and the path it is at. The
	 * path ends the line because it is what a reader scans when they know the
	 * API and the summary is what they read when they do not.
	 */
	.endpoints a {
		align-items: baseline;
		border-block-start: 1px solid var(--sl-color-gray-5);
		color: inherit;
		display: grid;
		gap: 0.125rem 1rem;
		grid-template-columns: 3.25rem minmax(0, 1fr) auto;
		padding-block: 0.5rem;
		text-decoration: none;
	}

	.endpoints li:last-child a {
		border-block-end: 1px solid var(--sl-color-gray-5);
	}

	.summary {
		color: var(--sl-color-white);
		font-size: 0.9375rem;
	}

	.endpoints a:hover .summary {
		color: var(--sl-color-text-accent);
	}

	.endpoints .path {
		color: var(--sl-color-gray-3);
		font-family: var(--sl-font-mono);
		font-size: 0.75rem;
		overflow-wrap: anywhere;
	}

	/*
	 * The types as names in a block rather than as a row each. A reader here is
	 * looking a name up, so what the list has to do is put fifty of them where
	 * one is found without scrolling.
	 */
	.types {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem 1rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.types a {
		color: var(--sl-color-text-accent);
		font-family: var(--sl-font-mono);
		font-size: 0.8125rem;
		text-decoration-color: var(--sl-color-gray-4);
	}

	.types a:hover {
		text-decoration-color: currentColor;
	}

	/* Below the width there is room for three columns, the path goes under. */
	@media (max-width: 44rem) {
		.endpoints a {
			grid-template-columns: 3.25rem minmax(0, 1fr);
		}

		.endpoints .path {
			grid-column: 2;
		}
	}
</style>
