---
import Example from '../../layouts/Example.astro';
import Filters from '../../examples/shared/Filters.astro';

/*
 * The look every demo shares, then what this one adds to it. Both are asked
 * for here, in that order, because that is the order they have to be applied
 * in and the only place the two are named together - the bundler is free to
 * inline one stylesheet and link the other, and then what wins is the order
 * they were imported in rather than which one is more specific.
 */
import '../../examples/shared/exofind.css';
import '../../examples/airports/main.css';
---

<Example
	title="Airport type-ahead"
	description="Every airport with an IATA code, completed as you type with Exofind. The line above the results says how many milliseconds each keystroke took."
	index="airports"
>
	<section class="ask">
		<p class="eyebrow">OurAirports · every airport with an IATA code</p>
		<div class="ask__field">
			<input class="ask__input" type="search" id="query"
				placeholder="sto" autocomplete="off" spellcheck="false" autofocus
				aria-label="Search airports by name, city or code">
		</div>
		<div class="ask__row">
			<ul class="suggestions" id="suggestions">
				<li><button type="button">sto</button></li>
				<li><button type="button">ord</button></li>
				<li><button type="button">bom</button></li>
				<li><button type="button">stockhlm</button></li>
				<li><button type="button">heathro</button></li>
				<li><button type="button">ES</button></li>
			</ul>
			<p class="status" id="status" role="status"></p>
		</div>

		<p class="lede">
			Every keystroke runs a search. <strong>sto</strong> completes to
			Stockholm, <strong>stockhlm</strong> still finds it,
			and <strong>ES</strong> lists every code that starts with those
			letters.
		</p>
	</section>

	<div class="split">
		<Filters>
			<div class="filters__group">
				<h2 class="eyebrow">Size</h2>
				<div id="sizes"></div>
			</div>
			<div class="filters__group">
				<h2 class="eyebrow">Service</h2>
				<div id="scheduled"></div>
			</div>
			<div class="filters__group">
				<h2 class="eyebrow">Near</h2>
				<div class="origins" id="origins"></div>
				<div id="radius"></div>
				<p class="origins__note" id="origin-note"></p>
			</div>
			<button class="clear" type="button" id="clear" hidden>Clear filters</button>
		</Filters>

		<section class="results">
			<div class="controls">
				<div class="weighing" role="group" aria-label="How much a hit in each field counts">
					<h2 class="eyebrow">Weighting</h2>
					<button class="weigh" type="button" id="weigh-declared" aria-pressed="true">
						as the index declares
					</button>
					<button class="weigh" type="button" id="weigh-flat" aria-pressed="false">
						every field equal
					</button>
				</div>
			</div>
			<ul class="hits" id="hits"></ul>
		</section>
	</div>

	<p slot="footer">
		Elevations are in feet and distances are as the crow flies. Data
		from <a href="https://ourairports.com/data/">OurAirports</a>, dedicated
		to the public domain.
	</p>
</Example>

<script>
	import '../../examples/airports/main.js';
</script>
