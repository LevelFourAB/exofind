---
import Example from '../../layouts/Example.astro';
import Filters from '../../examples/shared/Filters.astro';

/*
 * The look every demo shares, then what this one adds to it. Both are asked
 * for here, in that order, because that is the order they have to be applied
 * in and the only place the two are named together - the bundler is free to
 * inline one stylesheet and link the other, and then what wins is the order
 * they were imported in rather than which one is more specific.
 */
import '../../examples/shared/exofind.css';
import '../../examples/cleveland/main.css';
---

<Example
	title="Cleveland Museum of Art"
	description="30 000 open access objects from the Cleveland Museum of Art, searched with Exofind. Facet counts ignore the filter they belong to, and the results page by number or by cursor."
	index="cleveland"
>
	<section class="ask">
		<p class="eyebrow">The Cleveland Museum of Art · Open Access</p>
		<div class="ask__field">
			<input class="ask__input" type="search" id="query"
				placeholder="gold" autocomplete="off" spellcheck="false" autofocus
				aria-label="Search the collection">
		</div>
		<div class="ask__row">
			<ul class="suggestions" id="suggestions">
				<li><button type="button">gold</button></li>
				<li><button type="button">silk</button></li>
				<li><button type="button">portrait</button></li>
				<li><button type="button">dragon</button></li>
				<li><button type="button">woodblock</button></li>
				<li><button type="button">still life</button></li>
			</ul>
			<p class="status" id="status" role="status"></p>
		</div>
		<p class="lede">
			Tick a department and the objects narrow, but the department counts
			stay as they were. Type in the box above and every count narrows,
			the departments included.
		</p>
	</section>

	<div class="split">
		<Filters>
			<div class="filters__group">
				<h2 class="eyebrow">Department</h2>
				<div id="departments"></div>
			</div>
			<div class="filters__group">
				<h2 class="eyebrow">Kind of object</h2>
				<div id="types"></div>
			</div>
			<div class="filters__group">
				<h2 class="eyebrow">Where from</h2>
				<div id="places"></div>
			</div>
			<div class="filters__group">
				<h2 class="eyebrow">Made</h2>
				<div id="made"></div>
			</div>
			<div class="filters__group">
				<div id="on-view"></div>
			</div>
			<button class="clear" type="button" id="clear" hidden>Clear filters</button>
		</Filters>

		<section class="results">
			<div class="controls">
				<div class="control" role="group" aria-label="Order">
					<h2 class="eyebrow">Order</h2>
					<button class="pick" type="button" id="sort-best" aria-pressed="true">best match</button>
					<button class="pick" type="button" id="sort-old" aria-pressed="false">oldest</button>
					<button class="pick" type="button" id="sort-new" aria-pressed="false">newest</button>
				</div>
				<div class="control" role="group" aria-label="Paging">
					<h2 class="eyebrow">Paging</h2>
					<button class="pick" type="button" id="paging-pages" aria-pressed="true">numbered</button>
					<button class="pick" type="button" id="paging-cursor" aria-pressed="false">keep going</button>
				</div>
			</div>

			<ul class="grid" id="hits"></ul>

			<nav class="pager" id="pager" aria-label="Pages"></nav>
		</section>
	</div>

	<p slot="footer">
		Images are served by the museum and shown here by link. Object metadata
		from <a href="https://openaccess-api.clevelandart.org/">the Cleveland
		Museum of Art's open access collection</a>, released
		under <a href="https://creativecommons.org/publicdomain/zero/1.0/">CC0</a>.
	</p>
</Example>

<script>
	import '../../examples/cleveland/main.js';
</script>
