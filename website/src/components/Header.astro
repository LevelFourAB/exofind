---
/*
 * The header row: the site name and the sections on one side, everything a
 * reader operates on the other.
 *
 * Starlight has no top navigation of its own, and the sidebar is not a
 * substitute for one here - the front page and the demo pages are shown
 * without it, so a reader who arrives at either has no sign that there are
 * how-to guides at all. The sections are what this replaces the stock header
 * for; what they are is `../nav.mjs`.
 *
 * The search is on the trailing side with the theme and the links, rather
 * than in the middle where Starlight puts it. Starlight's header is a grid
 * built to line the search box up with the column the prose is in, which only
 * reads as deliberate on a page that has that column: the front page and the
 * demo pages do not, and they are the pages a reader meets first. Gathering
 * every control at one end is the same row on every page.
 *
 * Below the width the sidebar appears at the sections are dropped, and the
 * theme and the links with them - the mobile menu holds both, and the header
 * keeps only the title and the search.
 *
 * The theme control is three cells rather than a dropdown, and why is on
 * `./ThemeSelect.astro`. It arrives here through the virtual module rather
 * than by being imported by name, because the mobile menu shows the same
 * control and both have to be the same one.
 *
 * The search is kept across a routed navigation rather than rebuilt. Starlight
 * mounts the search interface into it once the document has loaded, which on a
 * routed page happens for the document the reader arrived in and never again -
 * a rebuilt search would open on a dialog nothing had been put into. Every
 * other control here is a custom element, and those are built again from the
 * markup that arrives.
 */
import config from 'virtual:starlight/user-config';

import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

import { sectionsOf } from '../nav.mjs';

const sections = sectionsOf(Astro.locals.starlightRoute.sidebar);

/* Starlight renders no search when there is nothing to search. */
const searchable =
	config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';
---

<div class="header">
	<div class="left-group sl-flex">
		<div class="title-wrapper sl-flex">
			<SiteTitle />
		</div>

		<nav class="sections sl-hidden lg:sl-flex" aria-label="Sections">
			{sections.map(section => (
				<a href={section.href} aria-current={section.current ? 'true' : undefined}>
					{section.label}
				</a>
			))}
		</nav>
	</div>

	<div class="right-group sl-flex print:hidden">
		{searchable && <div class="search sl-flex" transition:persist><Search /></div>}

		<div class="meta sl-hidden md:sl-flex">
			<div class="social-icons sl-flex">
				<SocialIcons />
			</div>
			<ThemeSelect />
			<LanguageSelect />
		</div>
	</div>
</div>

<style>
	.header {
		align-items: center;
		display: flex;
		gap: var(--sl-nav-gap);
		height: 100%;
		justify-content: space-between;
	}

	.left-group {
		align-items: center;
		gap: 1.75rem;
		min-width: 0;
	}

	.title-wrapper {
		/* Keep a long title off the search and the menu button on a narrow window. */
		overflow: clip;
		/* Leave room for the focus ring around the link inside. */
		padding: 0.25rem;
		margin: -0.25rem;
		min-width: 0;
	}

	.sections {
		align-items: center;
		font-size: var(--sl-text-sm);
		gap: 1.25rem;
	}

	.sections a {
		color: var(--sl-color-gray-2);
		text-decoration: none;
		white-space: nowrap;
	}

	.sections a:hover {
		color: var(--sl-color-white);
	}

	.sections a[aria-current='true'] {
		color: var(--sl-color-text-accent);
		font-weight: 600;
	}

	.right-group,
	.meta,
	.social-icons {
		align-items: center;
		gap: 1rem;
	}

	/* The hairline that separates what leaves the site from what changes it. */
	.social-icons::after {
		content: '';
		height: 1.375rem;
		border-inline-end: 1px solid var(--sl-color-gray-5);
	}

	.social-icons :global(a) {
		color: var(--sl-color-gray-2);
	}

	.social-icons :global(a:hover) {
		color: var(--sl-color-white);
	}

	/*
	 * The search button fills whatever it is given, so how wide it comes out
	 * is decided here rather than on the button. Given as a width rather than
	 * a flex basis, because the row is laid out around what its parts ask for
	 * and a basis that may be shrunk is not asked for. Only from the width
	 * where the button becomes a box: below that it is an icon.
	 */
	@media (min-width: 50rem) {
		.search {
			width: 20rem;
			min-width: 0;
		}
	}
</style>
